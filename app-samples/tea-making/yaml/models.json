{
  "models": {
    "perceive": {
      "category": "vlm",
      "adapter": {
        "kind": "openai_compat",
        "model_name": "llm",
        "reasoning_field": "reasoning_content",
        "capabilities": {
          "streaming": true,
          "vision": true
        },
        "default_extras": {
          "max_tokens": 128,
          "temperature": 0.0,
          "chat_template_kwargs": {
            "enable_thinking": false
          }
        }
      },
      "endpoint": {
        "base_url": "http://localhost:8108"
      }
    },
    "answer_with_reasoning": {
      "adapter": {
        "preset": "nemotron_omni"
      },
      "endpoint": {
        "base_url": "http://localhost:8108"
      }
    },
    "decide": {
      "category": "decision",
      "adapter": {
        "kind": "systemone",
        "model_name": "Cloudflare/clef-flash"
      },
      "endpoint": {
        "base_url": "http://localhost:8120"
      }
    },
    "speech_out": {
      "adapter": {
        "preset": "pocket_tts"
      },
      "endpoint": {
        "base_url": "http://localhost:8105"
      }
    }
  }
}
